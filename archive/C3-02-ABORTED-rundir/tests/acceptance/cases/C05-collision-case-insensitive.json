      { "op": "replace", "find": "x2.dat", "replaceWith": "Keep.Txt", "regex": false, "ignoreCase": false }
    ]
  },
  "expected": {
    "items": [
      ["keep.txt", "keep.txt", "collision"],
      ["x1.dat", "KEEP.TXT", "collision"],
      ["x2.dat", "Keep.Txt", "collision"]
    ],
    "summary": { "total": 3, "ok": 0, "collision": 3, "unchanged": 0, "invalid": 0 }
  }
