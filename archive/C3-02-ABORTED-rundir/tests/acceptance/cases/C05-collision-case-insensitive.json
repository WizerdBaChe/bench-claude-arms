{
  "name": "collision is case-insensitive, both against other items and against existing files",
  "files": [
    { "name": "keep.txt", "content": "k" },
    { "name": "x1.dat", "content": "1" },
    { "name": "x2.dat", "content": "2" }
  ],
  "rules": {
    "applyTo": "nameAndExtension",
    "sort": "name",
    "steps": [
